<Project>
  <!--
    Local builds were failing with:
      MSB4276: The default SDK resolver failed to resolve SDK
      "Microsoft.NET.SDK.WorkloadAutoImportPropsLocator" / "Microsoft.NET.SDK.WorkloadManifestTargetsLocator"

    Those SDK resolver components are part of the .NET SDK install. This repo is a standard ASP.NET Core solution
    and does not require mobile workloads, so we disable workload resolution to keep restore/build stable.
  -->
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <!-- Avoid reading user-level NuGet.Config (access denied in this environment). -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <!-- Keep restore/build offline-friendly. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
